<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Fuse</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Fuse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ojasvamishra.fuse</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fuse</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Fuse reads your calendar so it can fuse events with the other screen, and adds events you approve.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Fuse adds calendar events you approve.</string>
	<key>NSCameraUsageDescription</key>
	<string>Fuse uses the camera so you can fuse what you see with what's on the other screen.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Fuse centers the map on you.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Fuse listens while you hold the seam so you can say what to fuse.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Fuse saves images you fuse to your photo library when you ask.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Fuse reads photos you pick so it can fuse them with the other screen.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Fuse turns your voice into an instruction for the fuse.</string>
	<key>OPENAI_API_KEY</key>
	<string>$(OPENAI_API_KEY)</string>
	<key>OPENAI_MODEL</key>
	<string>$(OPENAI_MODEL)</string>
	<key>REVENUECAT_API_KEY</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_PROJECT_REF</key>
	<string>$(SUPABASE_PROJECT_REF)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
