{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "Fuse",
  "description": "Fuse remembers what you read so you can fold it into something.",
  "version": "1.0",
  "icons": { "128": "icon-128.png" },
  "background": { "scripts": ["background.js"], "persistent": false },
  "content_scripts": [ { "js": ["render.js", "content.js"], "matches": ["<all_urls>"], "run_at": "document_idle" } ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon-128.png",
    "default_title": "Fuse"
  },
  "permissions": ["nativeMessaging", "activeTab", "tabs", "<all_urls>"]
}
